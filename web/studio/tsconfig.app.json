{
  "//": "Browser SPA (non-canvas pages). Strict, bundler resolution (Vite), React JSX. DOM only.",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@troubastack/ink": ["../ink/src/index.ts"]
    }
  },
  "//references": "T85: beatPhase.ts is owned by tsconfig.contract.json (shared with e2e); exclude it here and resolve it through the reference so it is not compiled by two projects.",
  "references": [{ "path": "./tsconfig.contract.json" }],
  "include": ["src", "../ink/src"],
  "exclude": ["src/beatPhase.ts"]
}
