# Generated protobuf code (regenerated from proto/ in CI — I1)
core/internal/gen/
web/proto-gen/
app/shared/src/commonMain/kotlin/gen/

# Go
/core/bin/
*.test
*.out

# Local dev store data (TROUBA_STORE=file|git)
core/troubadata/
core/troubadata-*/
*.troubadata/

# Deploy secrets + backup archives (OPS01) — never commit
deploy/.env
troubastack-backup-*.tgz

# Demo seed PDF cache (fetched/generated at seed time)
core/cmd/seed/assets/

# Node / web
node_modules/
web/**/dist/
web/**/.vite/
*.tsbuildinfo

# Kotlin / Gradle / Android
.gradle/
app/**/build/
local.properties
*.iml

# iOS — the .xcodeproj + Info.plist are generated from app/iosApp/project.yml by xcodegen (IOS02)
app/iosApp/*.xcodeproj/
app/iosApp/Info.plist
app/iosApp/DerivedData/

# Bake artifacts / scratch
*.local
.DS_Store

# Playwright output (any depth — a root-level test-results/ slipped into 50e0ce8)
test-results/
playwright-report/

# IDE
.idea/
.vscode/
.kotlin/

# OPS02: app binaries are dropped into deploy/apps/ for the image build (not committed)
deploy/apps/*.apk
core/gen-mirrors

# DEMO-VID Part B — generated recording artifacts (video is a release/hosting artifact, not versioned)
web/studio/test-results/
web/studio/walkthrough/output/
core/troubadata-walkthrough/

# DEMO-VID Part D — generated narration WAVs + assembled MP4 (release artifacts, not versioned)
docs/video/output/

# Local, real bands (NOT demo content) — each user's own band folder(s) that the seed
# discovers (bands/<slug>/band.json + repertoire.json + source files, incl. copyrighted
# covers' PDFs/lyrics). Entirely local; never committed. Override dir with TROUBA_BANDS_DIR.
bands/
