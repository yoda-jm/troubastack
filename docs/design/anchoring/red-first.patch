+++ b/core/internal/app/bandio_anchor_matrix_test.go
@@ -0,0 +1,167 @@
+package app_test
+
+// The export/import column of the annotation-anchoring matrix (see chartpdf/anchor_matrix_test.go): a band
+// folder round trip, per shape, on a GENERATED chart. P30: a linked mark comes back with the same link and
+// render hash. P31: a mark that arrives WITHOUT a link (an old folder, coordinates only) is linked on
+// import when it sits on or beside text, exactly as the HTTP import path does. Known-red cells skip unless
+// ANCHOR_RED=1.
+
+import (
+	"reflect"
+	"testing"
+
+	"troubastack/core/internal/chartpdf"
+	"troubastack/core/internal/domain"
+	"troubastack/core/internal/testutil"
+)
+
+const matrixChart = "# The Open Road\n\n## Verse 1\nG            D\nPack a little light for the road ahead\n" +
+	"Em           C\nLeave the porch light on when the sun goes down\n"
+
+// knownRedBandio: red on today's code (baseline 2026-10-11). Delete a line when its fix lands.
+var knownRedBandio = map[string][2]string{
+	"freehand/import_links_unlinked_mark":  {"P31", "import-link"},
+	"line/import_links_unlinked_mark":      {"P31", "import-link"},
+	"rect/import_links_unlinked_mark":      {"P31", "import-link"},
+	"ellipse/import_links_unlinked_mark":   {"P31", "import-link"},
+	"text/import_links_unlinked_mark":      {"P31", "import-link"},
+	"highlight/import_links_unlinked_mark": {"P31", "import-link"},
+	"icon/import_links_unlinked_mark":      {"P31", "import-link"},
+	"jump_pair/import_links_unlinked_mark": {"P31", "import-link"},
+}
+
+func TestAnchorMatrixBandio(t *testing.T) {
+	shapes := map[string]domain.ObjectType{
+		"freehand": domain.TypeFreehand, "line": domain.TypeLine, "rect": domain.TypeRect,
+		"ellipse": domain.TypeEllipse, "text": domain.TypeText, "highlight": domain.TypeHighlight,
+		"icon": domain.TypeIcon, "jump_pair": domain.TypeIcon,
+	}
+	order := []string{"freehand", "line", "rect", "ellipse", "text", "highlight", "icon", "jump_pair"}
+	for _, shape := range order {
+		for _, linked := range []bool{true, false} {
+			shape, linked := shape, linked
+			name := shape + "/export_import_round_trip"
+			if !linked {
+				name = shape + "/import_links_unlinked_mark"
+			}
+			t.Run(name, func(t *testing.T) {
+				if r, ok := knownRedBandio[name]; ok {
+					testutil.AnchorKnownRed(t, r[0], r[1])
+				}
+				runBandioCell(t, shape, shapes[shape], linked)
+			})
+		}
+	}
+}
+
+func runBandioCell(t *testing.T, shape string, typ domain.ObjectType, linked bool) {
+	src := newStack()
+	admin, err := src.svc.Register("owner", "Owner", "password123", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	band, err := src.svc.CreateBand(admin, "Demo Band")
+	if err != nil {
+		t.Fatal(err)
+	}
+	song, err := src.svc.CreateSong(admin, band.ID, "The Open Road", "Demo")
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := src.svc.CreateTextChart(admin, band.ID, song.ID, matrixChart)
+	if err != nil {
+		t.Fatal(err)
+	}
+	apply := func(m domain.Mutation) {
+		t.Helper()
+		if _, err := src.eng.Apply(song.ID, m); err != nil {
+			t.Fatal(err)
+		}
+	}
+	apply(domain.Mutation{Kind: domain.KindLayerCreate, AuthorID: admin.ID, Layer: &domain.Layer{
+		ID: "L1", FileID: f.ID, Name: "Marks", OwnerID: domain.SharedOwner, Zone: domain.ZoneShared, Access: domain.AccessRW,
+	}})
+
+	_, anchors, err := chartpdf.RenderWithAnchors(matrixChart)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var line chartpdf.Anchor
+	for _, a := range anchors {
+		if a.Text == "Leave the porch light on when the sun goes down" {
+			line = a
+		}
+	}
+	h := line.Y1 - line.Y0
+	box := []domain.Point{{X: line.X0 + 0.05, Y: line.Y0 + 0.1*h}, {X: line.X0 + 0.15, Y: line.Y1 - 0.1*h}}
+	pts := box
+	switch shape {
+	case "text":
+		pts = box[:1]
+	case "freehand":
+		pts = []domain.Point{box[0], {X: box[1].X, Y: box[0].Y}, box[1], {X: box[0].X, Y: box[1].Y}}
+	}
+	objs := []domain.Object{{UUID: "m1", LayerID: "L1", Type: typ, Page: 0, Version: 1, OwnerID: admin.ID,
+		Points: pts, Text: map[bool]string{true: "star", false: ""}[typ == domain.TypeIcon],
+		Style: domain.Style{Color: "#e11d48", Opacity: 1, Width: 0.003, FontSize: 0.02}}}
+	if typ == domain.TypeText {
+		objs[0].Text = "softly"
+	}
+	if shape == "jump_pair" {
+		d := objs[0]
+		d.UUID = "m2"
+		objs[0].JumpTo = "m2"
+		objs = append(objs, d)
+	}
+	for i := range objs {
+		if linked {
+			objs[i] = chartpdf.AnchorObject(objs[i], anchors, f.BlobHash)
+			if objs[i].Anchor == nil {
+				t.Fatal("fixture: the mark did not link at creation")
+			}
+		}
+		o := objs[i]
+		apply(domain.Mutation{Kind: domain.KindCreate, UUID: o.UUID, AuthorID: admin.ID, Object: &o})
+	}
+
+	zipBytes, _, err := src.svc.ExportBand(admin, src.eng, band.ID)
+	if err != nil {
+		t.Fatalf("export: %v", err)
+	}
+	tgt := newStack()
+	importer, err := tgt.svc.Register("owner", "Owner", "password123", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	rep, err := tgt.svc.ImportBand(importer, tgt.eng, zipBytes, nil)
+	if err != nil {
+		t.Fatalf("import: %v", err)
+	}
+	songs, _ := tgt.repo.SongsOfBand(rep.Band.ID)
+	snap, err := tgt.eng.Head(songs[0].ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]domain.Object{}
+	for _, o := range snap.LiveObjects() {
+		got[o.UUID] = o
+	}
+	for _, want := range objs {
+		g, ok := got[want.UUID]
+		if !ok {
+			t.Fatalf("%s did not survive the round trip", want.UUID)
+		}
+		if linked {
+			// P30: the link and the render it was computed on come back unchanged.
+			if !reflect.DeepEqual(g.Anchor, want.Anchor) || g.PointsRenderHash != want.PointsRenderHash {
+				t.Errorf("%s: link %+v / %q after import, want %+v / %q", want.UUID, g.Anchor, g.PointsRenderHash, want.Anchor, want.PointsRenderHash)
+			}
+		} else if g.Anchor == nil {
+			// P31: a coordinates-only mark on a generated chart, sitting on a line, is linked on import.
+			t.Errorf("%s: imported onto a generated chart with no link, though it sits on a line of text", want.UUID)
+		}
+		if want.JumpTo != "" && g.JumpTo != want.JumpTo {
+			t.Errorf("%s: jump pairing lost on import (%q, want %q)", want.UUID, g.JumpTo, want.JumpTo)
+		}
+	}
+}
diff --git a/core/internal/chartpdf/anchor_matrix_test.go b/core/internal/chartpdf/anchor_matrix_test.go
new file mode 100644
index 00000000..9d860fd6
--- /dev/null
+++ b/core/internal/chartpdf/anchor_matrix_test.go
@@ -0,0 +1,817 @@
+package chartpdf
+
+// The annotation-anchoring matrix: one subtest per (shape × event) cell, each asserting the DESIRED
+// property from the anchoring spec (P-ids in the cell table), not today's behaviour. Cells known to be red
+// on today's code are listed in knownRed and skip unless ANCHOR_RED=1 (testutil.AnchorKnownRed).
+//
+//	ANCHOR_RED=1 go test ./internal/chartpdf/ -run AnchorMatrix -v     (the full picture)
+//	go test ./internal/chartpdf/                                        (CI: known-red cells skip)
+//
+// The harness drives the PRODUCTION functions at three seams, each named SEAM below:
+//   - create  → AnchorObject (what sync/apply.go KindCreate and the import path call);
+//   - move / resize / restyle → mirrors sync/apply.go's default branch TODAY: the client's points are
+//     taken, the client's anchor and render hash ride along unchanged (no re-anchor). When T191 lands, this
+//     seam must call the new re-anchor function; the sync-level cells (anchor_matrix_sync_test.go) observe
+//     the real apply path;
+//   - a source edit or re-layout → a fresh RenderWithAnchors + Reproject (what serve and bake call).
+//
+// Fixture text is synthetic (no real song). The target line deliberately carries a typo ("lihgt") so the
+// typo cells can fix it.
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+
+	"troubastack/core/internal/domain"
+	"troubastack/core/internal/testutil"
+)
+
+const (
+	mxT     = "Leave the porch lihgt on when the sun goes down" // the target line T (typo on purpose)
+	mxTLong = mxT + " and the town asleep"                      // fits at the default size, wraps at 16 pt
+	mxRow   = "Em           C"                                  // T's chord row
+	mxB     = "Every mile is a song we have not sung"           // last line of verse 1 (free space below)
+	mxC     = "Take me where the river bends"                   // a chorus line (jump destination)
+	mxV3    = mxB                                               // the line a moved mark is moved onto
+)
+
+func mxBody(target string) string {
+	return "## Verse 1\n" +
+		"G            D\nPack a little light for the road ahead\n" +
+		mxRow + "\n" + target + "\n" +
+		"G            D\n" + mxB + "\n\n" +
+		"## Chorus\n" +
+		"C        G\nOh the open road\n" +
+		"D            G\n" + mxC + "\n\n" +
+		"## Verse 2\n" +
+		"G            D\nMorning finds us somewhere new\n" +
+		"Em           C\nCoffee cold and the radio on\n"
+}
+
+func mxSrc(header, body string) string {
+	if header != "" {
+		header += "\n"
+	}
+	return "# The Open Road\n" + header + "\n" + body
+}
+
+func mxReplace(t *testing.T, s, old, new string) string {
+	t.Helper()
+	if !strings.Contains(s, old) {
+		t.Fatalf("fixture edit: %q not found", old)
+	}
+	return strings.Replace(s, old, new, 1)
+}
+
+// ---- frames: a line's own coordinate system (characters across, line-heights down) ----
+
+type mxFrame struct {
+	page          int
+	x0, y0, cw, h float64
+}
+
+func mxFrameOf(a Anchor) mxFrame {
+	n := float64(len([]rune(a.Text)))
+	return mxFrame{page: a.Page, x0: a.X0, y0: a.Y0, cw: (a.X1 - a.X0) / n, h: a.Y1 - a.Y0}
+}
+
+func (f mxFrame) at(ch, rel float64) domain.Point {
+	return domain.Point{X: f.x0 + ch*f.cw, Y: f.y0 + rel*f.h}
+}
+
+// mxIdent names a line by its text and source-order occurrence; prefix matches a wrapped line's first
+// visual segment.
+type mxIdent struct {
+	text   string
+	occ    int
+	prefix bool
+}
+
+func (w *mxWorld) frame(id mxIdent) (mxFrame, bool) {
+	if !id.prefix {
+		a, ok := runAt(w.anchors, id.text, id.occ)
+		return mxFrameOf(a), ok
+	}
+	seen := 0
+	for _, i := range sourceOrder(w.anchors) {
+		a := w.anchors[i]
+		if strings.HasPrefix(id.text, a.Text) && strings.HasPrefix(a.Text, "Leave the porch") {
+			seen++
+			if seen == id.occ {
+				return mxFrameOf(a), true
+			}
+		}
+	}
+	return mxFrame{}, false
+}
+
+// ---- the world: one chart's current source + render ----
+
+type mxWorld struct {
+	t       *testing.T
+	src     string
+	anchors []Anchor
+	hash    string
+}
+
+func newMxWorld(t *testing.T, src string) *mxWorld {
+	w := &mxWorld{t: t}
+	w.setSrc(src)
+	return w
+}
+
+func (w *mxWorld) setSrc(src string) {
+	w.t.Helper()
+	_, a, err := RenderWithAnchors(src)
+	if err != nil {
+		w.t.Fatalf("render: %v", err)
+	}
+	w.src, w.anchors = src, a
+	w.hash = fmt.Sprintf("%x", sha256.Sum256([]byte(src)))
+}
+
+func (w *mxWorld) must(id mxIdent) mxFrame {
+	w.t.Helper()
+	f, ok := w.frame(id)
+	if !ok {
+		w.t.Fatalf("fixture: line %q #%d not in the render", id.text, id.occ)
+	}
+	return f
+}
+
+// ---- marks ----
+
+type mxMark struct {
+	obj    domain.Object
+	placed []domain.Point // where the user put it (after any move/resize)
+	ref    mxIdent        // the line it should follow
+	keepX  bool           // margin mark: x is page-fixed, y follows the line (P4)
+	fixed  bool           // far mark: should never link (P5)
+}
+
+var mxShapes = []string{"freehand", "line", "rect", "ellipse", "text", "highlight", "icon", "jump_pair"}
+
+func loop(cx, cy, rx, ry float64, n int) []domain.Point {
+	pts := make([]domain.Point, 0, n)
+	for i := 0; i < n; i++ {
+		a := 2 * math.Pi * float64(i) / float64(n)
+		pts = append(pts, domain.Point{X: cx + rx*math.Cos(a), Y: cy + ry*math.Sin(a)})
+	}
+	return pts
+}
+
+func square(cx, cy, side float64) []domain.Point {
+	return []domain.Point{{X: cx - side/2, Y: cy - side/2}, {X: cx + side/2, Y: cy + side/2}}
+}
+
+func mxType(shape string) domain.ObjectType {
+	switch shape {
+	case "freehand":
+		return domain.TypeFreehand
+	case "line":
+		return domain.TypeLine
+	case "rect":
+		return domain.TypeRect
+	case "ellipse":
+		return domain.TypeEllipse
+	case "text":
+		return domain.TypeText
+	case "highlight":
+		return domain.TypeHighlight
+	}
+	return domain.TypeIcon
+}
+
+// build places the shape in the given variant on the world's current render. Geometry is realistic: a
+// rectangle is drawn with a margin around its line, an ellipse rings a word, a line is an arrow drawn
+// right-to-left (so a flip is visible), an icon is a stamp a little taller than the line.
+func (w *mxWorld) build(shape, variant string, tID mxIdent) []mxMark {
+	t := w.t
+	t.Helper()
+	fT := w.must(tID)
+	fB := w.must(mxIdent{mxB, 1, false})
+	fC := w.must(mxIdent{mxC, 1, false})
+	n := float64(len([]rune(tID.text)))
+	if tID.prefix {
+		n = 30
+	}
+	mk := func(pts []domain.Point, ref mxIdent) mxMark {
+		o := domain.Object{UUID: shape + "-" + variant, Type: mxType(shape), Page: w.must(ref).page,
+			Points: pts, Style: domain.Style{Color: "#e11d48", Opacity: 1, Width: 0.003, FontSize: 0.02}}
+		switch shape {
+		case "text":
+			o.Text = "softly"
+		case "icon", "jump_pair":
+			o.Text = "star"
+		}
+		cp := append([]domain.Point(nil), pts...)
+		return mxMark{obj: o, placed: cp, ref: ref}
+	}
+	bID := mxIdent{mxB, 1, false}
+	cID := mxIdent{mxC, 1, false}
+	var out []mxMark
+	switch variant {
+	case "on":
+		switch shape {
+		case "freehand":
+			c := fT.at(17.5, 0.5)
+			out = append(out, mk(loop(c.X, c.Y, 8*fT.cw, 1.0*fT.h, 24), tID))
+		case "line":
+			out = append(out, mk([]domain.Point{fT.at(30, 0.6), fT.at(5, 0.6)}, tID))
+		case "rect":
+			out = append(out, mk([]domain.Point{fT.at(-2, -0.4), fT.at(n+2, 1.4)}, tID))
+		case "ellipse":
+			out = append(out, mk([]domain.Point{fT.at(8.5, -0.5), fT.at(16.5, 1.5)}, tID))
+		case "text":
+			out = append(out, mk([]domain.Point{fT.at(20, 0.1)}, tID))
+		case "highlight":
+			out = append(out, mk([]domain.Point{fT.at(5, 0.05), fT.at(20, 0.95)}, tID))
+		case "icon":
+			c := fT.at(12, 0.5)
+			out = append(out, mk(square(c.X, c.Y, 1.6*fT.h), tID))
+		case "jump_pair":
+			c := fT.at(28, 0.5)
+			d := fC.at(10, 0.5)
+			out = append(out, mk(square(c.X, c.Y, 1.6*fT.h), tID), mk(square(d.X, d.Y, 1.6*fC.h), cID))
+		}
+	case "beside": // just under the last line of verse 1, in the gap before the chorus
+		switch shape {
+		case "freehand":
+			var p []domain.Point
+			for i := 0; i <= 12; i++ {
+				p = append(p, fB.at(2+float64(i)*28/12, 1.15+0.3*float64(i%2)))
+			}
+			out = append(out, mk(p, bID))
+		case "line":
+			out = append(out, mk([]domain.Point{fB.at(30, 1.3), fB.at(2, 1.3)}, bID))
+		case "rect":
+			out = append(out, mk([]domain.Point{fB.at(2, 1.1), fB.at(30, 1.5)}, bID))
+		case "ellipse":
+			out = append(out, mk([]domain.Point{fB.at(5, 1.1), fB.at(15, 1.5)}, bID))
+		case "text":
+			out = append(out, mk([]domain.Point{fB.at(5, 1.1)}, bID))
+		case "highlight":
+			out = append(out, mk([]domain.Point{fB.at(2, 1.05), fB.at(30, 1.45)}, bID))
+		case "icon":
+			c := fB.at(10, 1.35)
+			out = append(out, mk(square(c.X, c.Y, 0.5*fB.h), bID))
+		case "jump_pair":
+			c := fB.at(10, 1.35)
+			d := fC.at(10, 1.35)
+			out = append(out, mk(square(c.X, c.Y, 0.5*fB.h), bID), mk(square(d.X, d.Y, 0.5*fC.h), cID))
+		}
+	case "margin": // right of every line's text, level with T (where VLL's margin icons sit)
+		y := func(f mxFrame, rel float64) float64 { return f.y0 + rel*f.h }
+		var m []mxMark
+		switch shape {
+		case "freehand":
+			m = append(m, mk(loop(0.87, y(fT, 0.5), 0.03, 0.8*fT.h, 24), tID))
+		case "line":
+			m = append(m, mk([]domain.Point{{X: 0.85, Y: y(fT, -0.5)}, {X: 0.85, Y: y(fT, 1.5)}}, tID))
+		case "rect", "ellipse":
+			m = append(m, mk([]domain.Point{{X: 0.84, Y: y(fT, -0.2)}, {X: 0.90, Y: y(fT, 1.2)}}, tID))
+		case "text":
+			m = append(m, mk([]domain.Point{{X: 0.84, Y: y(fT, 0.1)}}, tID))
+		case "highlight":
+			m = append(m, mk([]domain.Point{{X: 0.84, Y: y(fT, 0)}, {X: 0.90, Y: y(fT, 1)}}, tID))
+		case "icon":
+			m = append(m, mk(square(0.87, y(fT, 0.5), 1.2*fT.h), tID))
+		case "jump_pair":
+			m = append(m, mk(square(0.87, y(fT, 0.5), 1.2*fT.h), tID), mk(square(0.87, y(fC, 0.5), 1.2*fC.h), cID))
+		}
+		for i := range m {
+			m[i].keepX = true
+		}
+		out = m
+	case "far": // the blank lower half of the page
+		var m []mxMark
+		switch shape {
+		case "freehand":
+			m = append(m, mk(loop(0.4, 0.68, 0.08, 0.02, 24), tID))
+		case "line":
+			m = append(m, mk([]domain.Point{{X: 0.5, Y: 0.68}, {X: 0.3, Y: 0.7}}, tID))
+		case "rect", "ellipse", "highlight":
+			m = append(m, mk([]domain.Point{{X: 0.3, Y: 0.66}, {X: 0.5, Y: 0.70}}, tID))
+		case "text":
+			m = append(m, mk([]domain.Point{{X: 0.3, Y: 0.66}}, tID))
+		case "icon":
+			m = append(m, mk(square(0.4, 0.68, 0.03), tID))
+		case "jump_pair":
+			m = append(m, mk(square(0.4, 0.68, 0.03), tID), mk(square(0.6, 0.68, 0.03), cID))
+		}
+		for i := range m {
+			m[i].fixed = true
+			m[i].obj.Page = 0
+		}
+		out = m
+	case "multi": // covers T's chord row, T, the next chord row and the next lyric (mxB)
+		row := w.must(mxIdent{mxRow, 1, false})
+		top := row.y0 - 0.1*row.h
+		bot := fB.y0 + 1.1*fB.h
+		x0, x1 := fT.at(2, 0).X, fT.at(30, 0).X
+		var pts []domain.Point
+		switch shape {
+		case "freehand":
+			pts = loop((x0+x1)/2, (top+bot)/2, (x1-x0)/2, (bot-top)/2, 24)
+		case "line":
+			pts = []domain.Point{{X: x1, Y: top}, {X: x0, Y: bot}}
+		case "rect", "ellipse", "highlight":
+			pts = []domain.Point{{X: x0, Y: top}, {X: x1, Y: bot}}
+		default:
+			return nil
+		}
+		// Rigid follow (P12, a DECISION): a multi-line mark follows the TOPMOST line it covers and never
+		// stretches; if the lines inside it move apart, it is flagged rather than reshaped.
+		out = append(out, mk(pts, mxIdent{mxRow, 1, false}))
+	}
+	if shape == "jump_pair" && len(out) == 2 {
+		out[0].obj.UUID, out[1].obj.UUID = "jump-src", "jump-dst"
+		out[0].obj.JumpTo = "jump-dst"
+	}
+	return out
+}
