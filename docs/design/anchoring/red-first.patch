+func TestAnchorMatrix(t *testing.T) {
+	for _, shape := range mxShapes {
+		for _, ev := range mxEvents {
+			shape, ev := shape, ev
+			if ev.multi && (shape == "icon" || shape == "text" || shape == "jump_pair") {
+				continue // N/A: a stamp or a text label has no multi-line form
+			}
+			t.Run(shape+"/"+ev.name, func(t *testing.T) {
+				if r, ok := knownRed[shape+"/"+ev.name]; ok {
+					testutil.AnchorKnownRed(t, r[0], r[1])
+				}
+				runCell(t, shape, ev)
+			})
+		}
+	}
+}
+
+func runCell(t *testing.T, shape string, ev mxEvent) {
+	src := mxSrc("", mxBody(mxT))
+	if ev.base != nil {
+		src = ev.base(t)
+	}
+	target := tID
+	if ev.target.text != "" {
+		target = ev.target
+	}
+	w := newMxWorld(t, src)
+	if ev.name == "size_change_wrapped_line" { // precondition: the line is one run now and wraps at 16 pt
+		if _, ok := runAt(w.anchors, mxTLong, 1); !ok {
+			t.Fatal("fixture: the long line already wraps at the default size")
+		}
+	}
+	if ev.name == "page_count_shrink" && w.must(target).page != 1 {
+		t.Fatal("fixture: the target line is not on page 2")
+	}
+	marks := w.build(shape, ev.vari, target)
+	if len(marks) == 0 {
+		t.Skip("N/A")
+	}
+
+	// SEAM create: what sync/apply.go KindCreate (via httpapi.chartAnchorer) and the import path call.
+	objs := make([]domain.Object, len(marks))
+	for i, m := range marks {
+		objs[i] = AnchorObject(m.obj, w.anchors, w.hash)
+	}
+
+	switch ev.expect {
+	case "linked":
+		for i, m := range marks {
+			wantRef := m.ref
+			a := objs[i].Anchor
+			if a == nil {
+				t.Errorf("%s: not linked at creation, want linked to %q", objs[i].UUID, wantRef.text)
+				continue
+			}
+			if a.RunText != wantRef.text || a.Occurrence != wantRef.occ {
+				t.Errorf("%s: linked to %q #%d, want %q #%d", objs[i].UUID, a.RunText, a.Occurrence, wantRef.text, wantRef.occ)
+			}
+		}
+		return
+	case "fixed":
+		for _, o := range objs {
+			if o.Anchor != nil {
+				t.Errorf("%s: linked to %q, want fixed (no text within reach)", o.UUID, o.Anchor.RunText)
+			}
+		}
+		return
+	}
+
+	// SEAM move/resize/restyle: today's sync/apply.go default branch takes the client object as is — the
+	// new points, the OLD anchor, the current render hash. T191 replaces this with a re-anchor.
+	for i := range marks {
+		switch ev.pre {
+		case "move":
+			from, to := w.must(marks[i].ref), w.must(mxIdent{mxV3, 1, false})
+			if marks[i].ref.text == mxC { // the jump destination stays put
+				continue
+			}
+			dy := to.y0 - from.y0
+			for j := range objs[i].Points {
+				objs[i].Points[j].Y += dy
+				marks[i].placed[j].Y += dy
+			}
+			marks[i].ref = mxIdent{mxV3, 1, false}
+			objs[i].PointsRenderHash = w.hash
+		case "resize":
+			x0, y0, _, _ := boundsOf(objs[i].Points)
+			for j := range objs[i].Points {
+				p := &objs[i].Points[j]
+				p.X, p.Y = x0+(p.X-x0)*1.5, y0+(p.Y-y0)*1.5
+				marks[i].placed[j] = *p
+			}
+			objs[i].PointsRenderHash = w.hash
+		case "restyle":
+			objs[i].Style.Color = "#2563eb"
+		}
+	}
+
+	old := &mxWorld{t: t, src: w.src, anchors: w.anchors, hash: w.hash}
+	if ev.expect == "transpose" {
+		// The bake: marks are projected against the STORED (untransposed) render, then composited on the
+		// transposed raster. P18: every mark sits on the same words of the transposed page.
+		from, _ := ParseKey("G")
+		to, _ := ParseKey("A")
+		tr, err := TransposeToKey(w.src, "A", from, to)
+		if err != nil {
+			t.Fatal(err)
+		}
+		out, _ := Reproject(objs, w.anchors, w.hash) // current hash: a no-op, as in stageFile
+		cur := newMxWorld(t, tr)
+		for i, m := range marks {
+			want, g := expected(m, old, cur, m.ref, m.ref)
+			checkGeom(t, shape, out[i], want, g.page, mxTol{0.001, 0.001}, false)
+		}
+		return
+	}
+
+	// SEAM edit: a source change re-renders the chart; serve and bake call Reproject.
+	w.setSrc(ev.edit(t, w.src))
+	out, _ := Reproject(objs, w.anchors, w.hash)
+
+	for i, m := range marks {
+		o := out[i]
+		expect := ev.expect
+		if expect == "lost" && m.ref.text != target.text {
+			expect = "follow" // a jump destination on another line: its line survives
+		}
+		switch expect {
+		case "lost":
+			if st := status(o, w); st != "lost" {
+				t.Errorf("%s: status %s, want lost (its line was deleted)", o.UUID, st)
+			}
+			for j := range m.placed {
+				if o.Points[j] != m.placed[j] {
+					t.Errorf("%s: a lost mark moved (point %d %v → %v); it must stay where it was", o.UUID, j, m.placed[j], o.Points[j])
+					break
+				}
+			}
+		case "exact":
+			if m.fixed {
+				if o.Anchor != nil {
+					t.Errorf("%s: a far mark is linked to %q", o.UUID, o.Anchor.RunText)
+				}
+				for j := range m.placed {
+					if o.Points[j] != m.placed[j] {
+						t.Errorf("%s: a fixed mark moved", o.UUID)
+						break
+					}
+				}
+				continue
+			}
+			want, g := expected(m, old, w, m.ref, m.ref)
+			checkGeom(t, shape, o, want, g.page, mxTol{0.001, 0.001}, m.keepX)
+		case "follow":
+			newRef := m.ref
+			if ev.after != nil && m.ref.text != mxC && m.ref.text != mxB {
+				newRef = ev.after(m.ref)
+			}
+			if _, ok := w.frame(newRef); !ok {
+				t.Fatalf("fixture: followed line %q #%d missing after the edit", newRef.text, newRef.occ)
+			}
+			if st := status(o, w); st != "linked" {
+				t.Errorf("%s: status %s after the edit, want linked", o.UUID, st)
+			}
+			want, g := expected(m, old, w, m.ref, newRef)
+			checkGeom(t, shape, o, want, g.page, lineTol(g), m.keepX)
+		}
+	}
+	if shape == "jump_pair" && (len(out) != 2 || out[0].JumpTo != out[1].UUID) {
+		t.Errorf("jump pairing lost: source JumpTo=%q", out[0].JumpTo)
+	}
+}
diff --git a/core/internal/sync/anchor_matrix_sync_test.go b/core/internal/sync/anchor_matrix_sync_test.go
new file mode 100644
index 00000000..091008bd
--- /dev/null
+++ b/core/internal/sync/anchor_matrix_sync_test.go
@@ -0,0 +1,136 @@
+package sync
+
+// The realtime half of the annotation-anchoring matrix (see chartpdf/anchor_matrix_test.go): what the hub
+// does to a mark's LINK when it is moved, resized, restyled or re-texted. Each cell asserts the DESIRED
+// property (P-ids from the anchoring spec); known-red cells skip unless ANCHOR_RED=1.
+//
+// The assertions are on the applied mutation only, so they hold whichever way the fix is built (a new
+// re-anchor seam, or AnchorMark after clearing): "the server decides the link, never the client" (P26).
+
+import (
+	"testing"
+
+	"troubastack/core/internal/domain"
+	"troubastack/core/internal/testutil"
+)
+
+// headEngine records the applied mutation and serves a HEAD holding one stored, linked mark.
+type headEngine struct {
+	fakeEngine
+	head domain.Snapshot
+	got  domain.Mutation
+}
+
+func (e *headEngine) Apply(_ string, m domain.Mutation) (domain.Mutation, error) {
+	e.got = m
+	return m, nil
+}
+func (e *headEngine) Head(string) (domain.Snapshot, error) { return e.head, nil }
+
+var storedLink = domain.SourceAnchor{RunText: "stored line", Occurrence: 1, CharStart: 0, CharEnd: 6}
+
+func runSyncCell(t *testing.T, kind string, client *anchorJSON) domain.Mutation {
+	t.Helper()
+	stored := domain.Object{UUID: "o1", LayerID: "l1", Type: domain.TypeRect, Version: 3, OwnerID: "u",
+		Points: []domain.Point{{X: 0.1, Y: 0.1}, {X: 0.3, Y: 0.15}}, Anchor: storedLink.Clone(),
+		PointsRenderHash: "render-now"}
+	eng := &headEngine{
+		fakeEngine: fakeEngine{
+			layer:      domain.Layer{ID: "l1", OwnerID: "u", Zone: domain.ZoneShared, Access: domain.AccessRW},
+			layerFound: true, objExists: true,
+		},
+		head: domain.Snapshot{Objects: []domain.Object{stored}},
+	}
+	hub := &Hub{eng: eng, applyLocks: map[string]*muRef{}}
+	hub.SetAnchorer(&stubAnchorer{})
+	r := &room{songID: "s1", conns: map[*conn]struct{}{}}
+	c := &conn{hub: hub, room: r, songID: "s1", authorID: "u", role: "member", send: make(chan []byte, 4)}
+	r.conns[c] = struct{}{}
+
+	pts := []pointJSON{{X: 0.1, Y: 0.4}, {X: 0.3, Y: 0.45}} // moved/resized somewhere else
+	if kind == "setStyle" || kind == "setText" {
+		pts = []pointJSON{{X: 0.1, Y: 0.1}, {X: 0.3, Y: 0.15}}
+	}
+	c.handleMutation(mutationJSON{Kind: kind, UUID: "o1", Object: &objectJSON{
+		UUID: "o1", LayerID: "l1", Type: "rect", Points: pts, Anchor: client, PointsRenderHash: "render-now",
+		Style: styleJSON{Color: "#2563eb"}, Text: "x",
+	}})
+	if eng.got.Object == nil {
+		t.Fatal("the mutation was not applied")
+	}
+	return eng.got
+}
+
+// knownRedSync: red on today's code (baseline 2026-10-11). Delete a line when its fix lands.
+var knownRedSync = map[string][2]string{
+	"move/relinks_server_side":          {"P23 P26", "T191"},
+	"move/old_link_not_kept":            {"P23", "T191"},
+	"resize/relinks_server_side":        {"P24 P26", "T191"},
+	"setStyle/keeps_stored_link":        {"P25 P26", "T191"},
+	"setText/keeps_stored_link":         {"P25 P26", "T191"},
+	"setStyle/missing_link_not_dropped": {"P25 P26", "T191"},
+}
+
+func TestAnchorMatrixSync(t *testing.T) {
+	forged := &anchorJSON{RunText: "client line", Occurrence: 1, CharStart: 0, CharEnd: 6}
+	same := &anchorJSON{RunText: storedLink.RunText, Occurrence: 1, CharStart: 0, CharEnd: 6}
+	cells := []struct {
+		name, kind string
+		client     *anchorJSON
+		check      func(t *testing.T, got *domain.SourceAnchor)
+	}{
+		// P23/P26: a move re-links from the new position, decided by the server. Today the client's anchor
+		// is applied as sent, so a forged (or merely stale) one survives.
+		{"move/relinks_server_side", "move", forged, func(t *testing.T, got *domain.SourceAnchor) {
+			if got != nil && got.RunText == "client line" {
+				t.Errorf("a move applied the client's link %q; the server must decide it (re-link or clear)", got.RunText)
+			}
+			if got != nil && got.RunText == storedLink.RunText {
+				t.Errorf("a move kept the pre-move link %q; it must re-link from where the mark now is", got.RunText)
+			}
+		}},
+		// P23: the realistic case, the client echoing back the anchor it was served. Still wrong to keep.
+		{"move/old_link_not_kept", "move", same, func(t *testing.T, got *domain.SourceAnchor) {
+			if got != nil && got.RunText == storedLink.RunText {
+				t.Errorf("a move kept the pre-move link %q (the measured bug: the mark jumps back at the next edit)", got.RunText)
+			}
+		}},
+		{"resize/relinks_server_side", "resize", same, func(t *testing.T, got *domain.SourceAnchor) {
+			if got != nil && got.RunText == storedLink.RunText && got.CharEnd == 6 {
+				t.Errorf("a resize kept the pre-resize link unchanged; it must re-link with the new extent")
+			}
+		}},
+		// P25: restyle / text change keep the STORED link (P26: never the client's).
+		{"setStyle/keeps_stored_link", "setStyle", forged, func(t *testing.T, got *domain.SourceAnchor) {
+			if got == nil || got.RunText != storedLink.RunText {
+				t.Errorf("a restyle changed the link to %+v; it must keep the stored %q", got, storedLink.RunText)
+			}
+		}},
+		{"setText/keeps_stored_link", "setText", forged, func(t *testing.T, got *domain.SourceAnchor) {
+			if got == nil || got.RunText != storedLink.RunText {
+				t.Errorf("a text change changed the link to %+v; it must keep the stored %q", got, storedLink.RunText)
+			}
+		}},
+		{"setStyle/echoed_link_kept", "setStyle", same, func(t *testing.T, got *domain.SourceAnchor) {
+			if got == nil || got.RunText != storedLink.RunText {
+				t.Errorf("a restyle dropped the link: %+v", got)
+			}
+		}},
+		// P26 also covers a client that drops the field: a restyle must not unlink the mark.
+		{"setStyle/missing_link_not_dropped", "setStyle", nil, func(t *testing.T, got *domain.SourceAnchor) {
+			if got == nil {
+				t.Errorf("a restyle sent without the anchor field unlinked the mark; the server must keep the stored link")
+			}
+		}},
+	}
+	for _, c := range cells {
+		c := c
+		t.Run(c.name, func(t *testing.T) {
+			if r, ok := knownRedSync[c.name]; ok {
+				testutil.AnchorKnownRed(t, r[0], r[1])
+			}
+			got := runSyncCell(t, c.kind, c.client)
+			c.check(t, got.Object.Anchor)
+		})
+	}
+}
diff --git a/core/internal/testutil/anchorred.go b/core/internal/testutil/anchorred.go
new file mode 100644
index 00000000..b8f4cda8
--- /dev/null
+++ b/core/internal/testutil/anchorred.go
@@ -0,0 +1,23 @@
+package testutil
+
+import (
+	"os"
+	"testing"
+)
+
+// AnchorKnownRed marks a test of the annotation-anchoring matrix (docs: anchoring spec, properties P1…)
+// whose DESIRED property is known to fail on today's code. It skips the test unless ANCHOR_RED=1, so plain
+// `go test ./...` stays green while
+//
+//	ANCHOR_RED=1 go test ./internal/chartpdf/ ./internal/sync/ ./internal/app/ -run AnchorMatrix -v
+//
+// shows the whole red/green picture. A fix flips a cell by deleting its AnchorKnownRed call (or its entry
+// in the matrix's knownRed table): the test then runs in CI and must pass.
+//
+// prop names the spec property the test asserts; task names the task expected to fix it.
+func AnchorKnownRed(t *testing.T, prop, task string) {
+	t.Helper()
+	if os.Getenv("ANCHOR_RED") != "1" {
+		t.Skipf("known red: %s, fixed by %s (ANCHOR_RED=1 runs it)", prop, task)
+	}
+}
