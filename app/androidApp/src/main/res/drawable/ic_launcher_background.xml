<!-- BRAND05 background — the tile ground. Source gTile is an objectBoundingBox linearGradient
     (x2=0.6 y2=1 as FRACTIONS of the box); VectorDrawable has no bounding-box mode, so the axis
     must be expressed in viewport units. The full-canvas path bbox is 1024x1024, so the fractions
     bake to endX=614.4 (=0.6*1024) endY=1024 (=1*1024). Emitted raw (0.6,1) the axis is one unit
     long in a 1024 viewport and the fill clamps to a flat #1B242D instead of ramping from #26333F.
     (BRAND05 Finding 1.) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path
        android:pathData="M0 0L1024 0 1024 1024 0 1024 0 0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="614.4"
                android:endY="1024">
                <item
                    android:color="#FF26333F"
                    android:offset="0"/>
                <item
                    android:color="#FF1B242D"
                    android:offset="1"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
