<?xml version="1.0" encoding="utf-8"?>
<!-- Thin Android shell (I15). One launcher Activity that hosts the shared app; no logic here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hosting the web Studio (I10) and reaching the core server need network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- B06: LAN discovery of the band server (mDNS via NsdManager) needs a Wi-Fi multicast lock so
         multicast packets are delivered on devices that filter them by default. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="true"
        android:label="TroubaShare"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
