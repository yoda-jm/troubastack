<?xml version="1.0" encoding="utf-8"?>
<!-- Thin Android shell (I15). One launcher Activity that hosts the shared app; no logic here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hosting the web Studio (I10) and reaching the core server need network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- B06: LAN discovery of the band server (mDNS via NsdManager) needs a Wi-Fi multicast lock so
         multicast packets are delivered on devices that filter them by default. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- A53: scan an invite QR with the camera. required="false" is deliberate — a camera must NEVER be an
         install requirement for a music-stand tablet; a denial/absence falls back to A52's paste field. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="TroubaStage"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- configChanges: handle rotation/resize in-place so Compose relayouts without recreating
             the Activity. Without this, rotating mid-performance recreated MainActivity and dropped
             App()'s `remember`ed nav state → kicked back to the Concerts list. It also lets Stage's
             A12 two-up engage on rotate (BoxWithConstraints re-measures) instead of exiting Stage. -->
        <!-- A52: launchMode=singleTask so a /join/ deep link into a RUNNING app is delivered to the
             existing instance via onNewIntent() instead of spawning a second MainActivity (and a second
             Stage). The cold-start intent is read in onCreate; both feed the same in-memory pendingLink. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A52: an invite link (http/https, path /join/…) offers TroubaStage. No autoVerify — these
                 are plain-http LAN servers with no hosted assetlinks.json, so Android shows a chooser
                 (Chrome / TroubaStage) rather than opening silently, which is correct for a URL from
                 outside. host="*" is deliberate (we can't enumerate our own hosts); it is safe only
                 because A51's ConfirmServer gate is load-bearing and tested. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" android:pathPrefix="/join/" />
                <data android:scheme="https" android:host="*" android:pathPrefix="/join/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
